{
  "name": "skyscheduler",
  "description": "Bluesky Post/Repost Scheduler on Cloudflare workers",
  "author": {
    "name": "socksthewolf",
    "url": "https://socksthewolf.com"
  },
  "funding": "https://ko-fi.com/socksthewolf",
  "license": "MIT",
  "homepage": "https://skyscheduler.work",
  "repository": "github:socksthewolf/skyscheduler",
  "private": true,
  "type": "module",
  "scripts": {
    "base:db:optimize": "wrangler d1 execute skyposts --command \"PRAGMA optimize\"",
    "base:db:migrate": "wrangler d1 migrations apply skyposts",
    "base:addinvitekey": "wrangler kv key put --binding INVITE_POOL",
    "build:pages": "tsx --env-file-if-exists=.env --env-file=bin/.env.build ./bin/build.ts",
    "build": "npm run build:pages && npm run minify",
    "code:lint:gen": "tsx ./bin/genlint.ts && npx prettier --write jsrules.config.ts",
    "code:lint:run": "eslint --stats --concurrency auto",
    "dev": "wrangler dev --live-reload",
    "dev:queue": "wrangler dev -c wrangler.toml --persist-to .wrangler/state --live-reload",
    "deploy": "wrangler deploy --minify",
    "auth": "npx auth@latest generate --config auth.config.ts --output src/db/auth.schema.ts -y && npx prettier --write src/db/auth.schema.ts",
    "optimize": "run-s migrate:*:pragma",
    "generate": "drizzle-kit generate",
    "eslint": "npm run lint",
    "lint": "run-s code:lint:*",
    "lint:fix": "eslint --fix",
    "migrate:local:db": "npm run base:db:migrate -- --local",
    "migrate:local:pragma": "npm run base:db:optimize -- --local -y",
    "migrate:prod:db": "npm run base:db:migrate -- --remote",
    "migrate:prod:pragma": "npm run base:db:optimize -- --remote -y",
    "migrate:local": "run-s migrate:local:*",
    "migrate:prod": "run-s migrate:prod:*",
    "migrate:remote": "npm run migrate:prod",
    "migrate:all": "npm run migrate:local && npm run migrate:prod",
    "minify:js:main": "minify assets/js/main.js > assets/js/min/main.min.js",
    "minify:js:app": "cat assets/js/*Helper.js | minify --js > assets/js/min/app.min.js",
    "minify:js": "run-p minify:js:**",
    "minify:css:base": "minify assets/css/stylesheet.css > assets/css/stylesheet.min.css && minify assets/css/dashboard.css > assets/css/dashboard.min.css",
    "minify:css:mods": "cat assets/css/*Mods.css | minify --css > assets/css/depmods.min.css",
    "minify:css": "run-p minify:css:**",
    "minify": "run-p minify:*",
    "invite:generate": "npx human-id@4.1.3 lowercase -",
    "invite:local": "npm run base:addinvitekey -- --local",
    "invite:remote": "npm run base:addinvitekey -- --remote",
    "sitemap": "sscli > assets/sitemap.xml && replace-in-file \"/homepage|\\.tsx/g\" \"\" assets/sitemap.xml",
    "openapi": "tsx ./bin/openapi.ts",
    "types": "wrangler types src/definitions/wrangler.d.ts"
  },
  "scriptsComments": {
    "build:pages": "builds the static website pages (recommended)",
    "dev": "run this application in development locally",
    "dev:queue": "runs the application in development but with queue support",
    "deploy": "uploads the local version directly to your worker",
    "auth": "builds the better auth db tables, should only ever be used once",
    "generate": "generates any db schema changes and their migration sql commands",
    "lint": "Runs ESLint on the project (app & browser code)",
    "migrate": "syncs the current migration steps directly into the given db, then optimizes it",
    "migrate:prod": "runs the above but only for production",
    "migrate:local": "runs migrate but only for local",
    "migrate:remote": "alias for migrate:prod",
    "optimize": "runs database optimizations for both local and production dbs",
    "minify": "runs minification/bundling on client scripts, done every build",
    "invite:generate": "generates an acceptable invite code",
    "invite:local <code> <usage #>": "commits an invite code directly to the local invite key store",
    "invite:remote <code> <usage #>": "the above for remote",
    "openapi": "creates the openapi.json file",
    "sitemap": "creates a sitemap.xml file",
    "types": "generates wrangler types"
  },
  "dependencies": {
    "@atproto/api": "^0.20.38",
    "@atproto/xrpc": "^0.8.10",
    "@hono/standard-validator": "^0.3.0",
    "better-auth": "^1.6.26",
    "better-auth-cloudflare": "0.3.1",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.13.1",
    "hono-openapi": "^1.3.1",
    "image-dimensions": "^2.5.1",
    "just-flatten-it": "^5.2.0",
    "just-is-empty": "^3.4.1",
    "just-random": "^3.2.0",
    "just-safe-get": "^4.2.0",
    "just-split": "^3.2.0",
    "just-truncate": "^2.2.0",
    "just-unique": "^4.2.0",
    "uuid": "^14.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "drizzle-kit": "^0.31.10",
    "minify": "^14.1.0",
    "npm-run-all2": "9.0.2",
    "replace-in-file": "^8.4.0",
    "static-sitemap-cli": "^2.2.8",
    "toml": "^5.0.0",
    "tsx": "^4.23.12",
    "typed-htmx": "^0.3.1",
    "wrangler": "^4.120.1"
  },
  "overrides": {
    "hono-openapi": {
      "@hono/standard-validator": "latest"
    },
    "@actions/github": {
      "undici": "^7.29.0"
    },
    "@actions/http-client": {
      "undici": "^7.29.0"
    },
    "@esbuild-kit/core-utils": {
      "esbuild": "^0.25.0"
    }
  },
  "optionalDependencies": {
    "@eslint/js": "^10.0.1",
    "@hono/eslint-config": "^2.1.1",
    "eslint": "^10.8.1",
    "globals": "^17.9.0",
    "jiti": "^2.7.0",
    "prettier": "^3.9.6",
    "typescript-eslint": "^8.66.0"
  }
}
